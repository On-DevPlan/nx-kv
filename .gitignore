# 依赖与产物
node_modules/
# vite 的 outDir：构建产物，emptyOutDir 会清空，不入库。
# 静态源资产（favicon/logo）的家是 src/web/frontend/public/（vite publicDir，
# 构建时自动整目录拷进 outDir），那里**入库**。
src/web/public/
*.log

# 工具隔离目录（scratch 工具不入库）
.tool/
.workbuddy/

# 临时目录（截图、一次性脚本等 scratch 产物，工作约定里就是可弃中间物）
temp/

# Playwright MCP 的产物目录（页面快照 yml / 截图 png）——调试用，不入库
.playwright-mcp/

# ============================================================
# Cloned repositories (nested git repos) — sl-git-standard
# 父目录必须用 /* 半透明模式，否则否定规则失效
# ============================================================
.claude/repo/*

!.claude/repo/_self/
!.claude/repo/_self/**

# agent 的临时工作树（EnterWorktree / 并行 subagent 用），属于本机状态，不入库
.claude/worktrees/

# .claude/www/git.remote 清单是仓库内容，随宿主提交（sl-git-standard）——
# 故意不写忽略规则：清单随仓库走，换机器/同事 clone 后 sync 才有输入
