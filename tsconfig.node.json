{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/node.tsbuildinfo"
  },
  // 毕业后：src 下只剩 .ts（唯一的 .js 是 src/index.js —— 面向包外消费方的 tsx 垫片，
  // 不属于编译单元，也不需要类型检查）。所以 allowJs/checkJs 已移除，
  // 「改了忘 build → 全局命令静默跑旧代码」这类问题在类型层也被堵住了。
  "include": ["src/**/*.ts"],
  "exclude": ["src/web/**"]
}
