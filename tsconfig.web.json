{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client 提供 import.meta.glob 的类型——前端路由自动发现靠它
    "types": ["node", "vite/client"],
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/web.tsbuildinfo"
  },
  // 毕业后：前端全部 .tsx/.ts，node 侧全部 .ts，allowJs/checkJs 已移除——
  // 于是 `no-undef` 那类「写了个没 import 的名字」的检查彻底交给 tsc（见 eslint.config.js），
  // lint 与 typecheck 不再有「一个管值、一个管类型」的缝。
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["src/web/public/**"]
}
