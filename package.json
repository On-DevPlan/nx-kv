{
  "name": "nx-kv",
  "version": "0.1.0",
  "description": "nx-kv — KV 清单管理中枢：serve 驱动 CLI 与 Web 面板，同源同构，附带可安装 skill 供 agent 领取主题任务",
  "type": "module",
  "bin": {
    "nx-kv": "bin/cli.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:serve": "node bin/cli.mjs serve --no-open",
    "start": "pnpm run build && node bin/cli.mjs serve",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "web-panel",
    "kv",
    "todo",
    "agent-tools",
    "skills",
    "npx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/On-DevPlan/nx-kv.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
