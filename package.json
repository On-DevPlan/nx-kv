{
  "name": "nx-kv",
  "version": "0.40.1",
  "description": "nx-kv — KV 清单管理中枢（远程）+ 本机本地任务队列（localtask）：serve 驱动 CLI 与 Web 面板，同源同构，附带可安装 skill 供 agent 提交 / 领取 / 阻塞接收任务",
  "type": "module",
  "bin": {
    "nx-kv": "bin/cli.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "vite build && node scripts/link-local.mjs --auto",
    "dev": "vite",
    "dev:serve": "node bin/cli.mjs serve --no-open",
    "start": "pnpm run build && node bin/cli.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint . && node scripts/check-tdz.mjs --all && node scripts/check-schema-decisions.mjs && node scripts/check-lines.mjs",
    "check:schema": "node scripts/check-schema-decisions.mjs",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:db": "node --test tests/unit/db-*.test.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "web-panel",
    "kv",
    "todo",
    "agent-tools",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/On-DevPlan/nx-kv.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "flexlayout-react": "0.11.1",
    "handlebars": "^4.7.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
